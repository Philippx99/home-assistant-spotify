#!/usr/bin/with-contenv bashio
set -e
echo "[spotify] Service gestartet; warte auf PulseAudio"
mkdir -p /data/chromium
export HOME=/data DISPLAY=:0
export PULSE_SERVER=unix:/run/pulse/native
until pactl info >/dev/null 2>&1; do sleep 1; done
Xvfb :0 -screen 0 1600x1000x24 -ac +extension RANDR &
sleep 2
if [ ! -S /tmp/.X11-unix/X0 ]; then echo "[spotify] FEHLER: Xvfb hat den X11-Socket nicht erstellt"; exit 1; fi
fluxbox &
exec chromium-browser --no-sandbox --disable-dev-shm-usage --no-first-run --password-store=basic --user-data-dir=/data/chromium --remote-debugging-address=127.0.0.1 --remote-debugging-port=9222 --start-fullscreen --autoplay-policy=no-user-gesture-required https://open.spotify.com/

